---
import Layout from '../../layouts/Layout.astro';
import Pen from '../../components/Pen.astro';
import { teaching, type TeachingRole } from '../../data/experience';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return teaching.map((role, i) => ({
    params: { slug: role.slug },
    props: { role, next: teaching[(i + 1) % teaching.length] },
  }));
}

interface Props {
  role: TeachingRole;
  next: TeachingRole;
}
const { role, next } = Astro.props;
---
<Layout title={`${role.title} · Venelle Matutina`} description={role.summary}>
  <div class="wrap">
    <a class="back" href={`${url('')}#teaching`}><span class="arrow" aria-hidden="true">←</span> All teaching work</a>
  </div>

  <article>
    <header class="wrap case-head">
      <p class="eyebrow" data-hero>Case study · Teaching</p>
      <h1 class="hero-title">{role.title}</h1>
      <p class="case-org" data-hero>{role.org}{role.unit && <> · {role.unit}</>}</p>
    </header>

    <div class="wrap chapter">
      <aside class="margin" aria-label="At a glance">
        <dl class="facts" data-reveal>
          <div><dt>When</dt><dd>{role.dates}</dd></div>
          <div><dt>Learners</dt><dd>{role.learners}</dd></div>
          <div><dt>Setting</dt><dd>{role.setting}</dd></div>
        </dl>
      </aside>

      <div class="case-body">
        <p class="lead" data-reveal>{role.summary}</p>

        <section data-reveal>
          <h2>What I <span class="annotate" data-pen>did<Pen /></span></h2>
          <ol class="did">
            {role.did.map((d) => <li>{d}</li>)}
          </ol>
        </section>

        {role.preparation && (
          <section data-reveal>
            <h2>Preparation</h2>
            <p>{role.preparation}.</p>
          </section>
        )}

        <section data-reveal>
          <h2>Skills practiced</h2>
          <ul class="tags">
            {role.skills.map((s) => <li>{s}</li>)}
          </ul>
        </section>

        {role.reflection && (
          <section data-reveal>
            <h2>Reflection</h2>
            <p class="reflection">{role.reflection}</p>
          </section>
        )}

        <a class="next-case" href={url(`teaching/${next.slug}/`)} data-reveal>
          <span class="eyebrow">Next case study →</span>
          <strong>{next.title}</strong>
          <span class="card-org">{next.org}</span>
        </a>
      </div>
    </div>
  </article>
</Layout>
