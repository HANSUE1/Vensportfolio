---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import Dividers from '../components/Dividers.astro';
import Star from '../components/Star.astro';
import Cover from '../components/Cover.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, works, leadership } from '../data/experience';
import { totalSessions } from '../data/seminars';
import { getImage } from 'astro:assets';
import portraitSrc from '../assets/portrait-circle.jpg';
import { rich } from '../lib/rich';
import { url } from '../lib/url';

const bySlug = Object.fromEntries(works.map((w) => [w.slug, w]));
const current = bySlug['literacy-tutor'];
const workHref = (slug: string) => url(`work/${slug}/`);
const leadHref = (id: string) => url(`leadership/#${id}`);
// One optimized WebP set, shared by the black-and-white layer and the colour layer.
const portrait = await getImage({ src: portraitSrc, format: 'webp', widths: [320, 420, 640, 840], sizes: '(min-width: 62rem) 420px, (min-width: 48rem) 320px, 240px' });

const fieldStudy = bySlug['field-study-teacher'];
const writing = bySlug['research-and-publication'];
const pair = [bySlug['cultural-buddy'], bySlug['nstp-pre-service-teacher']];
const leadCells = [
  { r: leadership[0], s: '--from:1;--to:3;--inset-left:29px' },
  { r: leadership[1], s: '--from:3;--to:4;--inset-right:30px' },
  { r: leadership[2], s: '--from:1;--to:2;--inset-left:28px;--inset-right:30px' },
  { r: leadership[4], s: '--from:2;--to:4;--inset-right:28px' },
];

const gallery = [
  { caption: 'Reading Log', href: url('learning/'), cover: { word: 'Learning', note: `${totalSessions} sessions`, bg: '#ece6ff', ink: '#4b2bd1', pattern: 'lines' as const } },
  { caption: 'Leadership', href: url('leadership/'), cover: { word: 'Leading', note: `${leadership.length} roles`, bg: '#fbe0ec', ink: '#b0346a', pattern: 'dots' as const } },
  { caption: 'About Me', href: url('about/'), cover: { word: 'Hi there!', note: 'venelle', bg: '#ffe3d6', ink: '#d2400a', pattern: 'none' as const } },
  { caption: 'Writing', href: workHref(writing.slug), cover: { word: 'Stories', note: 'involb', bg: '#e2eeff', ink: '#1a3362', pattern: 'grid' as const } },
  { caption: 'Teaching', href: workHref(current.slug), cover: { word: 'Read.', note: 'key stage 1', bg: '#dff3ee', ink: '#0f6b5c', pattern: 'lines' as const } },
];
---
<Base
  title="Portfolio · Venelle Matutina"
  description="Venelle Ericka A. Matutina is a pre-service English teacher at the Philippine Normal University–Manila: literacy tutoring, classroom teaching, writing, and student leadership."
  current="works"
>
  <!-- ───── Hero ───── -->
  <section class="hero">
    <div class="hero__inner">
      <h1 class="hero__intro" data-hero>
        {profile.first} {profile.last} is a <span class="hero__bold">Pre-service English teacher</span> based out of {profile.location}. Currently studying <span class="hero__bold">English Education</span> at <span class="hero__bold">PNU-Manila</span>
      </h1>
      <div class="hero__circle" data-hero>
        <a class="magnetic" href={url('about/')} data-magnetic aria-label={`About ${profile.first} ${profile.last}`}>
          <span class="magnetic__face">
            <img src={portrait.src} srcset={portrait.srcSet.attribute} sizes={portrait.attributes.sizes} width="840" height="840" alt="" fetchpriority="high" decoding="async" />
            <span class="magnetic__ring"></span>
          </span>
          <span class="magnetic__hover">
            <img src={portrait.src} srcset={portrait.srcSet.attribute} sizes={portrait.attributes.sizes} width="840" height="840" alt="" decoding="async" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <div class="hero-tickers" data-hero>
    <Ticker text="English educator. Literacy tutor. a storyteller." scroll="a" repeat={2} />
    <Ticker text="class president. writer. volunteer." scroll="b" repeat={2} />
  </div>

  <Dividers />

  <div class="skills-ticker">
    <Ticker variant="mono" faint scroll="b" repeat={8} text="Reading intervention. Lesson design. Journalistic writing. Public speaking." />
  </div>

  <div class="works-label">
    <Star />
    <h2 class="works-label__heading"><a class="works-label__link" href="#works-grid">Selected works</a></h2>
    <Star />
  </div>

  <!-- ───── Currently (teaser) ───── -->
  <section class="teaser" aria-labelledby="teaser-title">
    <div class="teaser__panel" data-reveal="scale" aria-hidden="true"></div>
    <div class="teaser__container">
      <div class="teaser__text" data-reveal="fade-up">
        <p class="teaser__eyebrow">Currently</p>
        <h3 class="teaser__title" id="teaser-title"><a href={workHref(current.slug)}>{current.role} at Phoenix Publishing House</a></h3>
        <p class="teaser__copy" set:html={rich(current.summary)} />
        <div class="teaser__tags">
          {current.tags.map((t) => <span class="tag tag--purple">{t}</span>)}
        </div>
      </div>
      <div class="teaser__images" data-reveal="fade-up">
        <div class="teaser__tall">
          <a class="teaser__tile" href={workHref(current.slug)} data-cursor-label="View" aria-label={`${current.role} case study`}>
            <Cover cover={current.cover} photo={`work/${current.slug}.jpg`} />
          </a>
        </div>
        <div class="teaser__stack">
          <a class="teaser__tile" href={workHref(current.slug)} data-cursor-label="View" tabindex="-1" aria-hidden="true">
            <Cover cover={{ word: 'a, b, c', note: 'phonics', bg: '#fff1c7', ink: '#8a5a00', pattern: 'dots' }} photo={`work/${current.slug}-2.jpg`} size="sm" />
          </a>
          <a class="teaser__tile" href={workHref(current.slug)} data-cursor-label="View" tabindex="-1" aria-hidden="true">
            <Cover cover={{ word: 'write!', note: 'literacy stations', bg: '#fbe0ec', ink: '#b0346a', pattern: 'grid' }} photo={`work/${current.slug}-3.jpg`} size="sm" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───── Works grid ───── -->
  <div class="works" id="works-grid">
    <div class="works__row" style="--tracks:1.5fr 1fr 1.5fr" data-row="1">
      <div class="works__cell works__cell--wide" style="--from:1;--to:4;--inset-right:30px">
        <ProjectCard href={workHref(fieldStudy.slug)} title={fieldStudy.title} summary={fieldStudy.summary} tags={fieldStudy.tags} cover={fieldStudy.cover} photo={`work/${fieldStudy.slug}.jpg`} height={350} wide />
      </div>
    </div>

    <div class="works__row" style="--tracks:1.5fr 1fr 1.5fr 1fr" data-row="2">
      {pair.map((w, i) => (
        <div class="works__cell project-card--narrow" style={i === 0 ? '--from:1;--to:3' : '--from:3;--to:5'}>
          <ProjectCard href={workHref(w.slug)} title={w.title} summary={w.summary} tags={w.tags} cover={w.cover} photo={`work/${w.slug}.jpg`} height={460} />
        </div>
      ))}
    </div>

    <div class="works__row" style="--tracks:1.5fr 1fr 1.5fr" data-row="3">
      <div class="works__cell works__cell--wide" style="--from:1;--to:4;--inset-right:30px">
        <ProjectCard href={workHref(writing.slug)} title={writing.title} summary={writing.summary} tags={writing.tags} cover={writing.cover} photo={`work/${writing.slug}.jpg`} height={350} wide />
      </div>
    </div>

    <div class="works__row" style="--tracks:1.5fr 1fr 1.5fr" data-row="4">
      {leadCells.map(({ r, s }) => (
        <div class="works__cell" style={s}>
          <ProjectCard href={leadHref(r.id)} title={r.title} tags={[r.dates, r.org.split(' · ')[0]]} cover={r.cover} photo={`work/${r.id}.jpg`} height={460} />
        </div>
      ))}
    </div>
  </div>

  <div class="closing-ticker">
    <Ticker text="a teacher. a writer. a lifelong learner." scroll="a" repeat={2} />
  </div>

  <div class="pull-up">
    <Dividers />
  </div>

  <!-- ───── What I've been up to ───── -->
  <section class="explore" aria-labelledby="explore-title">
    <div class="explore__intro">
      <svg class="explore__icon" viewBox="0 0 64 74" aria-hidden="true">
        <path d="M6 64V18c9-4 18-4 26 2 8-6 17-6 26-2v46c-9-4-18-4-26 2-8-6-17-6-26-2Z" />
        <path d="M32 20v46" />
        <path d="M12 28c5-1.5 10-1.5 15 1M12 36c5-1.5 10-1.5 15 1M37 29c5-2.5 10-2.5 15-1M37 37c5-2.5 10-2.5 15-1" />
        <path d="M46 4l4 9M50 2v7M54 5l-2 7" />
      </svg>
      <div>
        <h2 class="explore__title" id="explore-title">What I’ve been up to</h2>
        <p class="explore__label">Want to see more? The links below lead to my leadership work, the seminars that shaped my teaching, and a little more about me.</p>
      </div>
    </div>
    <div class="gallery">
      <div class="gallery__track" data-scroll="drift">
        {gallery.map((g) => (
          <figure class="gallery__item">
            <a class="gallery__caption" href={g.href}>{g.caption}</a>
            <a class="gallery__tile" href={g.href} data-cursor-label="Open" aria-label={g.caption} tabindex="-1">
              <Cover cover={g.cover} />
            </a>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
